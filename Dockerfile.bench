# Dependency-only image for the concurrency matrix (`make bench-concurrency`).
# Not the service image — this one exists so the benchmark can run under a real
# cgroup CPU quota instead of on a developer laptop, where core counts, BLAS
# kernels and background load make the numbers meaningless.
#
# App source is bind-mounted at run time rather than copied, so editing the
# harness does not rebuild the (large) torch layer.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /src
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

ENV PATH=/opt/venv/bin:$PATH
